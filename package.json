{
  "name": "spa-mailbox-automation",
  "version": "1.0.0",
  "private": true,
  "description": "PEP Passport SPA Box Automation - Agentic (WIT 504) - Decision Service",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
