{
  "swagger": "2.0",
  "info": {
    "title": "SPA Decision Service",
    "description": "Classification and decision service for the PEP Passport SPA shared mailbox automation (WIT 504). Returns an APPROVED action plan; the calling flow executes it verbatim and makes no decisions of its own.",
    "version": "1.0.0",
    "contact": { "name": "SPA Mailbox Automation" }
  },
  "host": "{FUNCTION_APP_HOSTNAME}",
  "basePath": "/api",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "oauth2-auth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/{TENANT_ID}/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/{TENANT_ID}/oauth2/v2.0/token",
      "scopes": { "api://{API_CLIENT_ID}/.default": "Access the SPA Decision Service" }
    }
  },
  "security": [{ "oauth2-auth": ["api://{API_CLIENT_ID}/.default"] }],
  "paths": {
    "/process": {
      "post": {
        "operationId": "ProcessEmail",
        "summary": "Classify an email and return the approved action plan",
        "description": "Runs the full pipeline: idempotency claim, loop and owner-response guards, normalisation, agentic classification, deterministic programme and multi-intent resolution, confidence banding, routing, and action validation.",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/ProcessRequest" } }
        ],
        "responses": {
          "200": { "description": "A decision and an approved action plan.", "schema": { "$ref": "#/definitions/ProcessResponse" } },
          "400": { "description": "The request was malformed." },
          "401": { "description": "Authentication failed." },
          "500": { "description": "Processing failed. Safe to retry: the idempotency claim prevents duplicate processing." }
        }
      }
    },
    "/actions/result": {
      "post": {
        "operationId": "RecordActionResults",
        "summary": "Record the outcome of each executed action",
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/ActionResultsRequest" } }
        ],
        "responses": { "202": { "description": "Recorded." }, "400": { "description": "Malformed." } }
      }
    },
    "/reports/weekly": {
      "post": {
        "operationId": "GenerateWeeklyReport",
        "summary": "Build the weekly Friday report",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": { "reportDate": { "type": "string", "format": "date-time", "description": "Defaults to now." } }
            }
          }
        ],
        "responses": {
          "200": { "description": "The report.", "schema": { "$ref": "#/definitions/WeeklyReportResponse" } },
          "501": { "description": "No processing data source is configured." }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "GetHealth",
        "summary": "Liveness and configuration readiness",
        "responses": {
          "200": { "description": "Healthy." },
          "503": { "description": "Configuration is invalid; the service is failing closed." }
        }
      }
    }
  },
  "definitions": {
    "EmailAddress": {
      "type": "object",
      "properties": { "address": { "type": "string" }, "name": { "type": "string" } },
      "required": ["address"]
    },
    "ProcessRequest": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "correlationId": { "type": "string", "description": "Generated by the caller; spans the whole run." },
        "message": {
          "type": "object",
          "required": ["id", "internetMessageId", "subject", "body", "from"],
          "properties": {
            "id": { "type": "string", "description": "Graph message id. Changes when the message moves folders." },
            "internetMessageId": { "type": "string", "description": "RFC 5322 Message-ID. The primary idempotency key." },
            "conversationId": { "type": "string" },
            "conversationIndex": { "type": "string" },
            "subject": { "type": "string" },
            "body": {
              "type": "object",
              "properties": { "contentType": { "type": "string", "enum": ["html", "text"] }, "content": { "type": "string" } }
            },
            "from": { "$ref": "#/definitions/EmailAddress" },
            "toRecipients": { "type": "array", "items": { "$ref": "#/definitions/EmailAddress" } },
            "ccRecipients": { "type": "array", "items": { "$ref": "#/definitions/EmailAddress" } },
            "receivedDateTime": { "type": "string", "format": "date-time" },
            "hasAttachments": { "type": "boolean" },
            "isRead": { "type": "boolean" },
            "internetMessageHeaders": {
              "type": "array",
              "items": { "type": "object", "properties": { "name": { "type": "string" }, "value": { "type": "string" } } }
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }, "name": { "type": "string" },
                  "contentType": { "type": "string" }, "size": { "type": "integer" }, "isInline": { "type": "boolean" }
                }
              }
            }
          }
        },
        "threadContext": {
          "type": "array",
          "description": "Recent messages on the same conversation. Drives owner-response suppression (FR-011).",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string" },
              "receivedDateTime": { "type": "string", "format": "date-time" },
              "subject": { "type": "string" }
            }
          }
        }
      }
    },
    "ActionPlanItem": {
      "type": "object",
      "properties": {
        "sequence": { "type": "integer" },
        "actionType": {
          "type": "string",
          "enum": ["SendResponse", "ForwardEmail", "MoveEmail", "MarkAsRead", "DeleteEmail", "RouteToChangeRequest", "RouteToProgramOwner", "EscalateToHumanReview", "GenerateReport"]
        },
        "parameters": {
          "type": "object",
          "properties": {
            "toRecipients": { "type": "array", "items": { "type": "string" } },
            "destinationFolder": { "type": "string" },
            "templateId": { "type": "string" },
            "subject": { "type": "string" },
            "body": { "type": "string" },
            "hardDelete": { "type": "boolean" },
            "humanReviewReason": { "type": "string" }
          }
        },
        "resolvedDestination": { "type": "string", "description": "The address or folder actually used. Always drawn from configuration (Rule 16)." },
        "scenarioId": { "type": "string" }
      }
    },
    "ProcessResponse": {
      "type": "object",
      "properties": {
        "processingId": { "type": "string" },
        "correlationId": { "type": "string" },
        "outcome": { "type": "string", "enum": ["EXECUTE", "SHADOW", "HUMAN_REVIEW", "SUPPRESS", "DUPLICATE"] },
        "confidenceBand": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "confidence": { "type": "number" },
        "classification": {
          "type": "object",
          "properties": {
            "scenarioId": { "type": "string" },
            "scenarioName": { "type": "string" },
            "program": { "type": "string", "enum": ["FIT", "FLO", "MEC_CGR", "ALL", "UNKNOWN"] },
            "subIntent": { "type": "string" },
            "multiIntent": { "type": "boolean" },
            "senderType": { "type": "string" },
            "extractedEntities": {
              "type": "object",
              "properties": {
                "learnerName": { "type": "string" }, "gpid": { "type": "string" }, "email": { "type": "string" },
                "program": { "type": "string" }, "island": { "type": "string" }, "week": { "type": "string" },
                "errorMessage": { "type": "string" }
              }
            },
            "reasoningSummary": { "type": "string", "description": "Business-readable only. Chain-of-thought is prohibited (Rule 11)." }
          }
        },
        "actionPlan": { "type": "array", "items": { "$ref": "#/definitions/ActionPlanItem" } },
        "humanReviewReason": { "type": "string" },
        "suppressionReason": { "type": "string" },
        "regionCode": { "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "appliedBothOwnersFallback": { "type": "boolean", "description": "True when the BRD fallback routed the email to both Jordan and Josh (FR-027)." }
      }
    },
    "ActionResultsRequest": {
      "type": "object",
      "required": ["processingId", "results"],
      "properties": {
        "processingId": { "type": "string" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": { "type": "integer" },
              "actionType": { "type": "string" },
              "status": { "type": "string", "enum": ["Succeeded", "Failed", "Skipped", "Shadowed"] },
              "graphRequestId": { "type": "string" },
              "errorCode": { "type": "string" },
              "errorMessage": { "type": "string" }
            }
          }
        }
      }
    },
    "WeeklyReportResponse": {
      "type": "object",
      "properties": {
        "report": {
          "type": "object",
          "properties": {
            "periodStart": { "type": "string" }, "periodEnd": { "type": "string" }, "generatedAt": { "type": "string" },
            "emailsByRegion": { "type": "object" },
            "scenarioByRegion": { "type": "array", "items": { "type": "object" } },
            "forwardedToProgramOwners": { "type": "integer" },
            "routedToSchooxOwner": { "type": "integer" },
            "routedToChangeRequest": { "type": "integer" },
            "resolved": { "type": "integer" },
            "totalEmails": { "type": "integer" },
            "humanReviewCount": { "type": "integer" },
            "unmappedRegionCount": { "type": "integer" },
            "gaps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "recipients": { "type": "array", "items": { "type": "string" } },
        "deliverable": { "type": "boolean", "description": "False when no recipients are configured (GAP-014); the flow must not guess an address." }
      }
    }
  }
}
