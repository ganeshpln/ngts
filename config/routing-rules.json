{
  "$comment": "Routing configuration seeded from BRD section 6. This file is the ONLY source of routing destinations (Rule 16). Seed for Dataverse spa_routingrule. Resolution order: exact programme match, then program=ALL, by ascending priority.",
  "version": "1.0.0",
  "lastModified": "2026-09-07",
  "multiIntent": {
    "$comment": "AD-003. Precedence is by descending scenario precedence value in scenarios.json; these rules override it.",
    "precedence": [
      "SC-08",
      "SC-04",
      "SC-07",
      "SC-01",
      "SC-02",
      "SC-03",
      "SC-05",
      "SC-09",
      "SC-06",
      "SC-12",
      "SC-10",
      "SC-11"
    ],
    "rules": [
      {
        "id": "MI-SCHOOX-PLUS",
        "when": {
          "includes": [
            "SC-07"
          ],
          "andAnyOf": [
            "SC-01",
            "SC-02",
            "SC-03",
            "SC-05",
            "SC-09",
            "SC-10"
          ]
        },
        "outcome": "EXECUTE_BOTH",
        "primary": "SC-07",
        "note": "BRD 6 Scenario 7 exclusion rule (R-2): FIT/FLO owners are involved only when a separate FIT/FLO issue is present."
      },
      {
        "id": "MI-CR-VS-TECH",
        "when": {
          "conflictingSubIntents": [
            "change_request",
            "technical"
          ]
        },
        "outcome": "HUMAN_REVIEW",
        "note": "Contradictory destinations and the BRD gives no precedence."
      },
      {
        "id": "MI-AUTOREPLY-WINS",
        "when": {
          "includes": [
            "SC-08"
          ]
        },
        "outcome": "SINGLE",
        "primary": "SC-08",
        "note": "Auto-replies carry no actionable content."
      },
      {
        "id": "MI-CRFORM-WINS",
        "when": {
          "includes": [
            "SC-04"
          ],
          "andMachineGenerated": true
        },
        "outcome": "SINGLE",
        "primary": "SC-04"
      },
      {
        "id": "MI-RESOLVED-PLUS",
        "when": {
          "includes": [
            "SC-11"
          ],
          "andAnyOther": true
        },
        "outcome": "HUMAN_REVIEW",
        "note": "A thanks combined with an open issue must not silently close it."
      },
      {
        "id": "MI-THREE-OR-MORE",
        "when": {
          "distinctActionableIntentsAtLeast": 3
        },
        "outcome": "HUMAN_REVIEW"
      },
      {
        "id": "MI-OWNER-CONFLICT",
        "when": {
          "differentResolvedOwnersWithNoOverlap": true
        },
        "outcome": "HUMAN_REVIEW"
      }
    ]
  },
